{
  "name": "maribel-alba-gallery",
  "version": "1.0.0",
  "description": "Gallery & restoration portfolio website for Maribel Alba",
  "type": "module",
  "scripts": {
    "dev": "npm run backend & npm run frontend",
    "frontend": "cd . && vite",
    "backend": "cd . && tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src server --ext ts,tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "axios": "^1.6.2",
    "@tanstack/react-query": "^5.28.0",
    "tailwindcss": "^3.4.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.11",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "tsx": "^4.7.0",
    "terser": "^5.30.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  }
}
